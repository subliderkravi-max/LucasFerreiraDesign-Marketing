<!DOCTYPE html>
<html lang="pt-br">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lucas Ferreira Design & Marketing</title>

<style>
:root{
  --bg:#1a1714;
  --gold:#c9a84c;
  --text:#f5f1e8;
  --muted:#b9b2a6;
}

/* BASE */
body{
  margin:0;
  font-family:Arial, sans-serif;
  background:var(--bg);
  color:var(--text);
}

/* TOP HERO */
.hero{
  height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:20px;
}

.hero h1{
  font-size:2.5rem;
  color:var(--gold);
  margin-bottom:10px;
}

.hero p{
  max-width:600px;
  color:var(--muted);
  line-height:1.6;
}

/* SIDEBAR */
.sidebar{
  position:fixed;
  left:0;
  top:0;
  width:70px;
  height:100%;
  background:#0f0d0b;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:20px;
  border-right:1px solid rgba(201,168,76,0.2);
}

.sidebar a{
  writing-mode:vertical-rl;
  transform:rotate(180deg);
  color:var(--gold);
  text-decoration:none;
  font-size:12px;
  letter-spacing:2px;
}

/* WHATSAPP FLOAT */
.whatsapp{
  position:fixed;
  right:20px;
  bottom:20px;
  background:#25D366;
  color:#fff;
  padding:15px 18px;
  border-radius:50px;
  text-decoration:none;
  font-weight:bold;
  box-shadow:0 5px 20px rgba(0,0,0,0.3);
}
.whatsapp small{
  display:block;
  font-size:10px;
}

/* CARD PRINCIPAL */
.card{
  background:#2a241e;
  padding:20px;
  border:1px solid rgba(201,168,76,0.2);
  border-radius:10px;
  max-width:500px;
  margin:30px auto 0;
}
.card h2{
  color:var(--gold);
  margin-bottom:10px;
}
.card p{
  color:var(--muted);
  font-size:14px;
  line-height:1.5;
}

.copy-btn{
  margin-top:10px;
  display:inline-block;
  padding:10px;
  background:var(--gold);
  color:#000;
  border:none;
  border-radius:6px;
  cursor:pointer;
}
</style>
</head>

<body>

<!-- SIDEBAR -->
<div class="sidebar">
  <a href="#">Lucas Ferreira</a>
  <a href="#contato">Contato</a>
  <a href="#portfolio">Portfólio</a>
</div>

<!-- HERO PRINCIPAL -->
<section class="hero">
  <div>
    <h1>Lucas Ferreira<br>Design & Marketing</h1>
    <p>
      Artes profissionais para negócios que querem vender mais:
      cardápios, flyers, redes sociais e identidade visual completa.
    </p>

    <!-- CARD DE ENTRADA -->
    <div class="card">
      <h2>🔥 Orçamento Rápido</h2>
      <p>
        Clique abaixo e me chame no WhatsApp com uma mensagem pronta para atendimento imediato.
      </p>

      <a class="whatsapp" 
         href="https://wa.me/5551992033109?text=Olá!%20Vi%20seu%20site%20e%20quero%20um%20orçamento%20rápido%20de%20design."
         target="_blank">
        Falar no WhatsApp
        <small>resposta rápida</small>
      </a>

      <button class="copy-btn" onclick="copyMsg()">
        Copiar mensagem
      </button>
    </div>
  </div>
</section>

<script>
function copyMsg(){
  const msg = "Olá! Vi seu site e quero um orçamento rápido de design.";
  navigator.clipboard.writeText(msg);
  alert("Mensagem copiada!");
}
</script>

</body>
</html>
